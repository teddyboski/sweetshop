# Copy this file to .env.local and fill in real values (never commit .env.local -
# it's already covered by .gitignore's ".env*.local" pattern).
#
# Mobile shares one backend with the web app - there is no separate mobile
# API or Supabase project. Pull these from the same place the web app's own
# .env.local / Vercel env vars come from.
#
# Any EXPO_PUBLIC_* variable is inlined into the client bundle at build time
# (Expo's equivalent of Next.js's NEXT_PUBLIC_* convention) - do not put a
# service-role key or any server-only secret behind this prefix.

# Same value as the web app's NEXT_PUBLIC_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_URL=

# Same value as the web app's NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# (the client-safe publishable/anon key - src/lib/supabase/auth-user.ts
# on the web side reads this same key under that exact env var name)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The deployed web app's base URL, no trailing slash - this is what
# authenticatedFetch() prefixes onto every /api/* call. Must be reachable
# from your phone (a production/preview URL works from anywhere; a
# localhost URL only works if the phone is on the same network or tunneled
# via `adb reverse`, and only over USB the way we're testing right now).
EXPO_PUBLIC_API_BASE_URL=
